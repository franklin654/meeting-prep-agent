# Copy to .env and fill in real values. Never commit .env (AGENTS.md hard rule 11).
# Every value below is a placeholder — no real API keys.

# --- App LLM (backend/app/config.py -> app/llm/client.py) ---
# Provider is chosen here, never in code: openai | groq | anthropic.
# Startup fails fast (naming the variable) on an unknown provider or a missing key
# for the selected provider. Only the selected provider's key is required.
LLM_PROVIDER=groq
LLM_MODEL=replace-with-a-model-for-the-selected-provider
OPENAI_API_KEY=replace-with-your-openai-api-key
GROQ_API_KEY=replace-with-your-groq-api-key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# How the backend reaches the hindsight container.
# docker-compose.yml overrides this to http://hindsight:8888 for the `api`
# service itself; set this for host-side tooling (e.g. running the backend
# outside Docker, or scripts in data/scripts/).
HINDSIGHT_URL=http://localhost:8888

# --- Hindsight container's own LLM (docs/hindsight-integration.md "Setup") ---
# Set separately from the app LLM above: openai | groq | anthropic. docker-compose.yml
# maps these onto Hindsight's HINDSIGHT_API_LLM_PROVIDER / _MODEL / _API_KEY.
# Reflect drives structured tool calls and fails loudly if the model can't do tool
# calling, whatever the provider -- pick a model that supports it.
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=replace-with-a-tool-calling-model
HINDSIGHT_LLM_API_KEY=replace-with-the-key-for-that-provider
# Fixed/stable worker id — a rotating Docker hostname leaves background jobs
# stuck after a restart (docs/hindsight-integration.md). Do not let this rotate.
HINDSIGHT_API_WORKER_ID=hindsight-demo-1
# Only applies when Hindsight uses groq (HINDSIGHT_LLM_PROVIDER=groq); ignored otherwise.
# Free-tier Groq keys don't have the `auto` service tier Hindsight requests by
# default (retain fails with "service_tier auto is not available for this org").
# docker-compose.yml already defaults this to on_demand; only set it here to
# override that default (e.g. once on a paid tier).
# HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand

# --- Structured store ---
DATABASE_URL=sqlite:///./app.db

# --- Demo fixtures ---
DEMO_USER_ID=user-demo-thomas
# Fixed clock so "overdue" / "3 weeks ago" are stable across rehearsals
# (docs/synthetic-data-spec.md). Never date.today() in business logic.
DEMO_TODAY=2026-09-28
