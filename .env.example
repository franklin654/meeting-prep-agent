# Copy to .env and fill in real values. Never commit .env (AGENTS.md hard rule 11).
# Every value below is a placeholder — no real API keys.

# --- App (backend/app/config.py, Groq via app/llm/client.py) ---
LLM_PROVIDER=groq
LLM_MODEL=replace-with-a-groq-model-that-supports-tool-use
LLM_API_KEY=replace-with-your-groq-api-key

# How the backend reaches the hindsight container.
# docker-compose.yml overrides this to http://hindsight:8888 for the `api`
# service itself; set this for host-side tooling (e.g. running the backend
# outside Docker, or scripts in data/scripts/).
HINDSIGHT_URL=http://localhost:8888

# --- Hindsight container's own LLM settings (docs/hindsight-integration.md "Setup") ---
# Reflect drives structured tool calls and fails loudly if the model can't do
# tool calling — pick one from the Hindsight model leaderboard that supports it.
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=replace-with-your-groq-api-key
HINDSIGHT_API_LLM_MODEL=replace-with-a-groq-model-that-supports-tool-use
# Fixed/stable worker id — a rotating Docker hostname leaves background jobs
# stuck after a restart (docs/hindsight-integration.md). Do not let this rotate.
HINDSIGHT_API_WORKER_ID=hindsight-demo-1
# Free-tier Groq keys don't have the `auto` service tier Hindsight requests by
# default (retain fails with "service_tier auto is not available for this
# org"). docker-compose.yml already defaults this to on_demand; only set it
# here to override that default (e.g. once on a paid tier).
# HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand

# --- Structured store ---
DATABASE_URL=sqlite:///./app.db

# --- Demo fixtures ---
DEMO_USER_ID=user-demo-thomas
# Fixed clock so "overdue" / "3 weeks ago" are stable across rehearsals
# (docs/synthetic-data-spec.md). Never date.today() in business logic.
DEMO_TODAY=2026-09-28
